{
  "name": "@pitant/chart-catalog",
  "version": "0.7.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-library/index.d.ts",
      "import": "./dist-library/chart-library.js"
    },
    "./styles.css": "./dist-library/chart-library.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "tsconfig.json",
    "SOURCE.md",
    "tsconfig.library.json",
    "vite.library.config.ts",
    "vite.native-source.ts",
    "LICENSE",
    "dist-library",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "npm run build:native && vite --host 127.0.0.1",
    "check": "npm run build:native && tsc --noEmit",
    "build": "npm run check && vite build && npm run build:library",
    "build:site": "npm run check && vite build --outDir ../../dist --emptyOutDir",
    "build:library": "npm run build:native && vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/catalog.test.mjs",
    "prepack": "npm run build:library",
    "build:native": "bun run --filter @pitant/charts build && bun run --filter @pitant/charts-react build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@number-flow/react": "0.6.2",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "3.1.2",
    "d3-sankey": "0.12.3",
    "d3-shape": "3.2.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.577.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@pitant/charts": "workspace:*",
    "@pitant/charts-react": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-shape": "3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.19.7",
    "fumadocs-ui": "16.19.7",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
