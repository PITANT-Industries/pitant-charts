{
  "name": "@pitant/charts-react",
  "version": "1.0.0",
  "description": "React 19 components for high-density PITANT industrial charts",
  "type": "module",
  "license": "MIT",
  "author": "Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PITANT-Industries/pitant-charts.git",
    "directory": "packages/charts-react"
  },
  "homepage": "https://charts.pitant.dev",
  "bugs": {
    "url": "https://github.com/PITANT-Industries/pitant-charts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@pitant/charts": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@pitant/charts": "1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "keywords": [
    "charts",
    "canvas",
    "canvas2d",
    "historian",
    "industrial",
    "line-chart",
    "performance",
    "plant-physics",
    "react",
    "scichart-alternative",
    "scientific",
    "timeseries",
    "visualization",
    "webgpu"
  ],
  "engines": {
    "node": ">=22"
  }
}
