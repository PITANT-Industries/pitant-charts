{
  "name": "@pitant/charts",
  "version": "1.0.0",
  "description": "WebGPU-first TypeScript chart core for high-density industrial time-series",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PITANT-Industries/pitant-charts.git",
    "directory": "packages/charts"
  },
  "homepage": "https://charts.pitant.dev",
  "bugs": {
    "url": "https://github.com/PITANT-Industries/pitant-charts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-engine": {
      "types": "./dist/data-engine/index.d.ts",
      "import": "./dist/data-engine/index.js"
    },
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "tsconfig.json",
    "SOURCE.md",
    "tsup.config.ts",
    "LICENSE-MIT",
    "dist",
    "styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "charts",
    "canvas",
    "canvas2d",
    "historian",
    "industrial",
    "line-chart",
    "performance",
    "plant-physics",
    "scichart-alternative",
    "scientific",
    "timeseries",
    "visualization",
    "webgpu"
  ],
  "engines": {
    "node": ">=22"
  }
}
