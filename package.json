{
  "name": "chart-library",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-library/index.d.ts",
      "import": "./dist-library/chart-library.js"
    },
    "./styles.css": "./dist-library/chart-library.css"
  },
  "files": [
    "dist-library",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && npm run build:library",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/catalog.test.mjs",
    "prepack": "npm run build:library"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "d3-shape": "3.2.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-shape": "3.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
